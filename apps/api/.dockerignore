# Laravel API .dockerignore

# Git
.git
.gitignore
.gitattributes

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Node
node_modules
npm-debug.log
yarn-error.log

# Development
.env
.env.backup
.env.production
.env.*.local

# IDE
.idea
.vscode
*.swp
*.swo

# Testing
.phpunit.result.cache
.phpunit.cache
coverage

# Build artifacts
/public/hot
/public/storage
/public/build

# Storage (keep structure, ignore files)
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/app/public/*
!/storage/app/public/.gitignore

# Vendor (installed via composer in Docker)
/vendor

# Bootstrap cache (rebuilt in Docker)
/bootstrap/cache/*.php

# Documentation
*.md
LICENSE
CHANGELOG

# OS files
.DS_Store
Thumbs.db

# Other apps in monorepo
apps/server
apps/laravel
src
packages
