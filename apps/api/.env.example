# AdminHub21 API — environment template
#
# Copy to `.env` (`cp .env.example .env`) and run `php artisan key:generate`.
# Every variable below is read by a file in config/; the values shown match the
# defaults there, so a fresh local install only needs APP_KEY.

APP_NAME=AdminHub21
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL is the deployed driver; sqlite is available for local runs and tests.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=adminhub21
DB_USERNAME=postgres
DB_PASSWORD=
# Alternatively provide a single connection string:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/adminhub21

# ── Cache / session / queue ────────────────────────────────────────────────
# Local development can stay on the file/sync defaults. The Docker stacks
# (docker-compose*.yml) switch these to redis.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_COOKIE=adminhub21_session
SESSION_DOMAIN=
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

# ── Redis (required when any redis driver above is enabled) ───────────────
# `predis` ships with composer, so no PHP extension is required; images that
# install phpredis can set REDIS_CLIENT=phpredis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default

# ── Auth ───────────────────────────────────────────────────────────────────
# Sanctum guards the API; tokens expire after SANCTUM_TOKEN_EXPIRATION minutes.
SANCTUM_STATEFUL_DOMAINS=localhost:8443,localhost:5173,localhost:8080
SANCTUM_TOKEN_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:8080

# ── Password hashing ───────────────────────────────────────────────────────
# argon2id is the default; legacy bcrypt hashes stay verifiable and are
# rehashed on next login. Set HASH_DRIVER=bcrypt to opt out.
HASH_DRIVER=argon2id
ARGON2ID_MEMORY=65536
ARGON2ID_THREADS=4
ARGON2ID_TIME=4
BCRYPT_ROUNDS=12

# ── Mail ───────────────────────────────────────────────────────────────────
# Mailpit listens on 1025 in docker-compose.yml; `log` keeps local mail in the log.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@adminhub21.test
MAIL_FROM_NAME="${APP_NAME}"

# ── Storage ────────────────────────────────────────────────────────────────
# User-uploaded media (avatars, portfolio images, contract PDFs) goes through
# config/media.php. Leave the defaults locally; in production set
#   MEDIA_DISK=s3
#   MEDIA_URL=https://cdn.example.com
# and the same upload code writes to the bucket and serves from the CDN.
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── AI providers ───────────────────────────────────────────────────────────
# Consumed by config/services.php and the ProcessAiRequest queue job.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Payment gateway callbacks ──────────────────────────────────────────────
# Each gateway validates an HMAC secret, an optional IP allowlist, a timestamp
# tolerance window and a replay cache TTL. Leave secrets empty locally.
ZIBAL_CALLBACK_SECRET=
ZIBAL_CALLBACK_ALLOWED_IPS=
ZIBAL_CALLBACK_TOLERANCE_SECONDS=300
ZIBAL_CALLBACK_REPLAY_TTL_SECONDS=300

SEP_CALLBACK_SECRET=
SEP_CALLBACK_ALLOWED_IPS=
SEP_CALLBACK_TOLERANCE_SECONDS=300
SEP_CALLBACK_REPLAY_TTL_SECONDS=300

CRYPTO_CALLBACK_SECRET=
CRYPTO_CALLBACK_ALLOWED_IPS=
CRYPTO_CALLBACK_TOLERANCE_SECONDS=300
CRYPTO_CALLBACK_REPLAY_TTL_SECONDS=300

# ── Horizon ────────────────────────────────────────────────────────────────
HORIZON_DOMAIN=
HORIZON_SLACK_WEBHOOK=
