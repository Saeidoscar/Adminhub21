# Copy to apps/server/.env and adjust. All values have safe development defaults,
# so the API boots without an .env file at all — except DATABASE_URL, which must
# point at a running PostgreSQL instance (see docker-compose.yml).
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adminhub

# Required in production: 16+ characters each, never reuse the dev defaults.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Optional: enables real model calls in apps/server/src/ai; without a key the
# AI endpoints run in mock mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
