# Root compose interpolation file — `cp .env.example .env`, then fill in.
# Docker Compose reads `.env` here to resolve ${...} in docker-compose.yml.
# `.env` is gitignored; never commit a real key.

# ── LayerCloud AI gateway — TRAINING CIRCLE ONLY ───────────────────────────
# Cheap OpenAI-compatible router. Not compliance-grade: prompts are forwarded
# to third-party upstream providers under their own retention policies.
# Scope: assistant chat, ticket triage, i18n drafting, moderation pre-screen.
# Never contracts, ID documents or payment data. Runbook: docs/ai/layercloud-trial.md
LAYERCLOUD_ENABLED=false
LAYERCLOUD_TRIAL_ONLY=true
LAYERCLOUD_API_KEY=
LAYERCLOUD_DEFAULT_MODEL=zai/glm-5.3-flash
LAYERCLOUD_DAILY_TOKEN_BUDGET=200000
LAYERCLOUD_MAX_OUTPUT_TOKENS=1024
