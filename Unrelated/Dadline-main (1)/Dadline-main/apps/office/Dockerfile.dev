# apps/office/Dockerfile.dev
# Development — Hot Reload با Turbopack، نصب وابستگی‌ها داخل volume جدا
# (مطابق نکته‌ی رفع‌شده در سند ۰۲: جلوگیری از تداخل node_modules ویندوز/کانتینر)

FROM node:22-alpine

RUN corepack enable
WORKDIR /repo

# فقط فایل‌های Manifest برای cache بهتر در ابتدا کپی می‌شوند
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

EXPOSE 3000

# نصب واقعی و اجرای dev server در command زمان start انجام می‌شود
# (نه در build) چون docker-compose.dev.yml کل ریشه‌ی مونوریپو را mount می‌کند
# و وابستگی‌ها باید روی همان bind mount نصب شوند، نه داخل ایمیج.
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter=office dev"]
