{
  "name": "adminhub21",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:demo": "vite --mode demo --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt src apps/web/src dev packages e2e",
    "dev:api": "docker compose up api nginx horizon",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:api:legacy": "pnpm --filter @adminhub/server dev",
    "dev:web": "pnpm --filter @adminhub/web dev",
    "build:web": "pnpm --filter @adminhub/web build",
    "start:web": "pnpm --filter @adminhub/web start"
  },
  "dependencies": {
    "@adminhub/design-tokens": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.73.0",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    }
  }
}
